-- raw[23..25] = r4_hdr10_flare_lens_color (hdr10_parameters10.xyz)
-- raw[26..29] = heat_vision_steps         (heatvision_params1.xyzw)
-- raw[30..33] = heat_vision_args_1        (heatvision_params3.xyzw)
-- raw[34..37] = heat_vision_args_2        (heatvision_params4.xyzw)
-- raw[38]     = heat_vision_blurring.w    (heatvision_params2.w)
-- Total = 38 floats, strictly partitioned into FIXED non-competing slots:
--   Player Slot : 11 floats (up to 18 immutable DualStep segments = ~25m)
--   NPC Slot 1  :  8 floats (up to 12 immutable DualStep segments = ~18m, PINNED!)
--   NPC Slot 2  :  7 floats (up to 10 immutable DualStep segments = ~15m, PINNED!)
--   NPC Slot 3  :  6 floats (up to  8 immutable DualStep segments = ~12m, PINNED!)
--   NPC Slot 4  :  6 floats (up to  8 immutable DualStep segments = ~12m, PINNED / 3DSS Scope Slot!)
-- Walking as the player NEVER steals floats from NPCs/Mutants and NEVER evicts pinned nearby trails!
local MAX_STREAM_FLOATS = 38
local PLAYER_FIXED_CAP  = 12
local NPC_SLOT_CAPS     = { 8, 7, 6, 5 }
local NUM_NPC_SLOTS     = 4
local END_STREAM_MARKER = 0.95
local last_raw38_val    = 0.95

local SKY_RAYS = {
    vector():set(0.0,   1.0,   0.0),
    vector():set(0.22,  0.975, 0.0),
    vector():set(-0.22, 0.975, 0.0),
    vector():set(0.0,   0.975, 0.22),
    vector():set(0.0,   0.975, -0.22),
}

