    "r4_hdr10_flare_ghost_ca",         -- slot 16 (hdr10_parameters8.y)
    "r4_hdr10_flare_blur_scale",       -- slot 17 (hdr10_parameters8.z)
    "r4_hdr10_ui_saturation",          -- slot 18 (hdr10_parameters8.w)
    "r4_hdr10_flare_ghost_intensity",  -- slot 19 (hdr10_parameters9.x)
    "r4_hdr10_flare_halo_intensity",   -- slot 20 (hdr10_parameters9.y)
