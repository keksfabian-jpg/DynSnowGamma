    "r4_hdr10_exposure",               -- slot 1  (hdr10_parameters3.x)
    "r4_hdr10_contrast",               -- slot 2  (hdr10_parameters3.y)
    "r4_hdr10_saturation",             -- slot 3  (hdr10_parameters3.z)
    "r4_hdr10_contrast_middle_gray",   -- slot 4  (hdr10_parameters3.w)
    "r4_hdr10_sun_dawn_begin",         -- slot 5  (hdr10_parameters5.x)
    "r4_hdr10_sun_dawn_end",           -- slot 6  (hdr10_parameters5.y)
    "r4_hdr10_sun_dusk_begin",         -- slot 7  (hdr10_parameters5.z)
    "r4_hdr10_sun_dusk_end",           -- slot 8  (hdr10_parameters5.w)
    "r4_hdr10_brightness",             -- slot 9  (hdr10_parameters6.x)
    "r4_hdr10_flare_threshold",        -- slot 10 (hdr10_parameters6.z)
    "r4_hdr10_flare_power",            -- slot 11 (hdr10_parameters6.w)
    "r4_hdr10_flare_ghost_dispersal",  -- slot 12 (hdr10_parameters7.y)
