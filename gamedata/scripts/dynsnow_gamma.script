local function clamp_val(x, lo, hi)
    if x < lo then return lo elseif x > hi then return hi end
    return x
end

local function exec_cached(key, cmd_str)
    if cmd_cache[key] ~= cmd_str then
        cmd_cache[key] = cmd_str
        get_console():execute(cmd_str)
    end
end

local function world_to_grid(x, z)
    local ix = clamp_val(math.floor(((x + WORLD_HALF) / WORLD_SPAN) * 16384.0), 0, 16383)
    local iz = clamp_val(math.floor(((z + WORLD_HALF) / WORLD_SPAN) * 16384.0), 0, 16383)
    return ix, iz
end

-- Encode 2-float Anchor Node (starts a chain at exact 14-bit world grid ix, iz with 5-bit fade 1..31)
local function encode_anchor_floats(ix, iz, s)
    local ist = clamp_val(math.floor(s * 31.0 + 0.5), 1, 31)
    local ix_lo7 = ix % 128
    local ix_hi7 = math.floor(ix / 128)
    local code0 = ix_lo7 * 16384 + iz
    local code1 = ist * 128 + ix_hi7
    return (0.5 + code0 / 8388608.0), (0.5 + code1 / 8388608.0)
end

-- Encode 1-float Dual-Scale Delta Node:
--   is_coarse = false (bit 19 = 0): exact 19.5cm grid step [-63..+63] (+-12.3m)
--   is_coarse = true  (bit 19 = 1): 6x landmark step (1.17m) [-63..+63]*6 (+-73.8m in 1 float!)
local function encode_delta_float(dx_step, dz_step, s, is_coarse)
    local ist = clamp_val(math.floor(s * 31.0 + 0.5), 1, 31)
    local dx7 = clamp_val(dx_step + 64, 1, 127)
    local dz7 = clamp_val(dz_step + 64, 1, 127)
    local coarse_bit = is_coarse and 524288 or 0
    local payload20 = coarse_bit + ((ist * 128) + dx7) * 128 + dz7
    return (0.5 + (2097152 + payload20) / 8388608.0)
end

-- Encode 2 Full-Map Campfires (16-bit X + 16-bit Z = 4.9cm precision across 3200m map!)
-- Inactive marker = 0.92 (safe inside all cvar min/max bounds)
local function encode_fullmap_campfires(p1, r1, p2, r2)
    local f_lo1, f_lo2 = 0.92, 0.92
    local m1, m2 = 0, 0

    if p1 and r1 > 0.008 then
        local ix1 = clamp_val(math.floor(((p1.x + WORLD_HALF) / WORLD_SPAN) * 65536.0), 0, 65535)
        local iz1 = clamp_val(math.floor(((p1.z + WORLD_HALF) / WORLD_SPAN) * 65536.0), 0, 65535)
        local lo1 = (ix1 % 128) * 65536 + iz1
        f_lo1 = 0.5 + lo1 / 16777216.0
        m1 = 512 + math.floor(ix1 / 128)
    end

    if p2 and r2 > 0.008 then
        local ix2 = clamp_val(math.floor(((p2.x + WORLD_HALF) / WORLD_SPAN) * 65536.0), 0, 65535)
        local iz2 = clamp_val(math.floor(((p2.z + WORLD_HALF) / WORLD_SPAN) * 65536.0), 0, 65535)
        local lo2 = (ix2 % 128) * 65536 + iz2
        f_lo2 = 0.5 + lo2 / 16777216.0
        m2 = 512 + math.floor(ix2 / 128)
    end

    local f_hi = (m1 == 0 and m2 == 0) and 0.92 or (0.5 + (m2 * 1024 + m1) / 8388608.0)
    return f_lo1, f_lo2, f_hi
end

local function sync_mcm(tg)
    if tg < last_cfg_sync_tg + 1500 then return end
    last_cfg_sync_tg = tg
    if dynsnow_gamma_mcm and dynsnow_gamma_mcm.get_config then
        cfg_always_snow       = dynsnow_gamma_mcm.get_config("always_snow") ~= false
        cfg_weapon_snow       = dynsnow_gamma_mcm.get_config("enable_weapon_snow") ~= false
        cfg_weapon_snow_int   = dynsnow_gamma_mcm.get_config("weapon_snow_intensity") or 1.0
        local ns = dynsnow_gamma_mcm.get_config("npc_snow_intensity")
        cfg_npc_snow_int      = (ns ~= nil) and ns or 0.25
        local os_val = dynsnow_gamma_mcm.get_config("object_snow_intensity")
        cfg_object_snow_int   = (os_val ~= nil) and os_val or 1.0
        cfg_enable_dynsnow    = dynsnow_gamma_mcm.get_config("enable_dynsnow") ~= false
        cfg_enable_npc_tracks = dynsnow_gamma_mcm.get_config("enable_npc_tracks") ~= false
        cfg_campfire_melt     = dynsnow_gamma_mcm.get_config("enable_campfire_melt") ~= false
        cfg_campfire_max_r    = dynsnow_gamma_mcm.get_config("campfire_melt_radius") or 2.2
        cfg_enable_env_fx     = dynsnow_gamma_mcm.get_config("enable_env_fx") ~= false
        cfg_ttl_mult          = dynsnow_gamma_mcm.get_config("track_ttl_mult") or 1.0
    end
end

local function is_underground_level()
    local lname = level.name and level.name() or nil
    if lname and UNDERGROUND_LEVELS[string.lower(lname)] == true then
        return true
    end
    local w = level.get_weather and level.get_weather() or nil
    if w and string.find(string.lower(w), "indoor") then
        return true
    end
    if level.outdoor and level.outdoor() == 0 then
        return true
    end
    return false
end

local function has_open_sky(pos, ignore_obj)
    if level_is_changing then return false end
    -- Start at +1.95m (above NPC head, backpack, and rifle) and raycast ONLY static map geometry (rqtStatic = 1)
    -- up to 7.0m overhead so indoor ceilings/roofs block snow while forest tree canopies (8-25m) NEVER block NPC snow trails!
    local origin = vector():set(pos.x, pos.y + 1.95, pos.z)
    local static_flag = (rq_target and rq_target.rqtStatic) or 1
    local open_votes = 0
    for i = 1, 3 do
        local pick = ray_pick()
        pick:set_position(origin)
        pick:set_direction(SKY_RAYS[i])
        pick:set_flags(static_flag)
        pick:set_range(7.0)
        if ignore_obj then pick:set_ignore_object(ignore_obj) end
        pick:query()
        local d = pick:get_distance()
        if d <= 0 or d >= 6.8 then
            open_votes = open_votes + 1
            if open_votes >= 2 then return true end
        end
    end
    return false
end

local function get_snowfall_state()
    if _G.inverno_snowfall_system and _G.inverno_snowfall_system.current_weather_state then
        return _G.inverno_snowfall_system.current_weather_state
    end
    return 3.0
end

local function is_actor_indoors()
    if not db.actor then return false end
    if _G.inverno_freezing_mechanic and _G.inverno_freezing_mechanic.is_actor_indoors then
        if _G.inverno_freezing_mechanic.is_actor_indoors() then
            return not has_open_sky(db.actor:position(), db.actor)
        end
        return false
    end
    return not has_open_sky(db.actor:position(), db.actor)
end

-- 1. Rich 100% Continuous Outdoor Snowfall Hook
local function pick_snow_state_for_weather()
    local w = string.lower((level.get_weather and level.get_weather()) or "")
    if string.find(w, "storm") then
        return 5
    elseif string.find(w, "rain") or string.find(w, "cloudy") then
        return 4
    end
    local hr = (level.get_time_hours and level.get_time_hours()) or 12
    return (hr % 3 == 0) and 4 or 3
end

local push_fast_uniforms -- forward declaration

local function ensure_inverno_always_snow_hook()
    local inv = _G.inverno_snowfall_system
    if inv then
        if not inverno_hooked and inv.process_dynamic_weather_logic then
            inverno_hooked = true
            local orig_logic = inv.process_dynamic_weather_logic
            inv.process_dynamic_weather_logic = function(...)
                orig_logic(...)
                if cfg_always_snow and not inv.is_manual_weather then
                    if inv.CONFIG then inv.CONFIG.SNOW_CHANCE_PERCENT = 100 end
                    local st = inv.target_weather_state or 1
                    if st <= 2 or st == 6 or st == 7 then
                        local desired = pick_snow_state_for_weather()
                        inv.target_weather_state = desired
                        if (inv.current_weather_state or 1) < 2.8 then
                            inv.current_weather_state = desired
                        end
                    end
                end
            end
        end

        if cfg_always_snow and not inv.is_manual_weather then
            local st = inv.target_weather_state or 1
            if st <= 2 or st == 6 or st == 7 then
                local desired = pick_snow_state_for_weather()
                inv.target_weather_state  = desired
                inv.current_weather_state = desired
            end
        end
    end

    -- Prevent inverno_freezing_mechanic from overwriting shader_param_2.zw (our campfire melt radii)
    local frz = _G.inverno_freezing_mechanic
    if frz and not inverno_freeze_hooked and frz.actor_on_update then
        inverno_freeze_hooked = true
        local orig_frz_update = frz.actor_on_update
        frz.actor_on_update = function(...)
            orig_frz_update(...)
            if push_fast_uniforms then
                cmd_cache["sp2"] = nil
                push_fast_uniforms()
            end
        end
    end
end

-- 2. Minimum 5-Minute (>= 305s) 3D Trench Lifetime & Smooth Start-to-End Decay
local function get_trench_ttl_sec()
    local w_state = get_snowfall_state()
    local base_ttl = 360.0
    if w_state >= 4.5 then
        base_ttl = 305.0
    elseif w_state >= 3.5 then
        base_ttl = 330.0
    end
    return math.max(90.0, base_ttl * cfg_ttl_mult)
end

local function eval_node_strength(pt, tg, ttl_sec)
    local age_sec = (tg - pt.t) * 0.001
    if age_sec >= ttl_sec then return 0.0 end
    if age_sec <= 0.0 then return pt.w end
    local u = age_sec / ttl_sec
    local fade
    if u <= 0.14 then
        fade = 1.0 - (u / 0.14) * 0.06
    else
        fade = 0.94 * (1.0 - ((u - 0.14) / 0.86))
    end
    return clamp_val(pt.w * fade, 0.0, 1.0)
end

local function is_inside_melted_campfire_zone(pos)
    if not cfg_campfire_melt then return false end
    for _, st in pairs(campfire_melt) do
        if st.r and st.r > 0.35 and st.pos then
            local eff_r = math.max(0.0, st.r - 0.25)
            if pos:distance_to_sqr(st.pos) <= (eff_r * eff_r) then
                return true
            end
        end
    end
    return false
end

-- Immutable Landmark World Trail Recorder:
--   1. Fine 0.55m..0.75m steps right under the actor's boots for crisp curve fidelity around sandbags & obstacles.
--   2. Once the actor walks >= 2 steps past a vertex, normal left-right gait sway (<= 32cm) is consolidated ONCE,
--      while real turns (> 31 deg or > 32cm offset) and 28m milestones are permanently locked (`landmark = true`).
--   3. Stabilized vertices NEVER move or resample per frame — 0.00mm jitter and 150-300m+ reach per trail!
local function append_world_trail_point(actor_id, pos, tg, base_w, force_new_chain)
    if math.abs(pos.x) > 1595.0 or math.abs(pos.z) > 1595.0 then return false end

    local chains = world_trails[actor_id]
    if not chains then
        chains = {}
        world_trails[actor_id] = chains
    end

    local chain = (not force_new_chain) and chains[#chains] or nil
    if not chain or chain.closed then
        chain = { uid = next_chain_uid, actor_id = actor_id, pts = {}, is_player = (actor_id == PLAYER_TRAIL_ID), closed = false }
        next_chain_uid = next_chain_uid + 1
        chains[#chains + 1] = chain
    end

    local ix, iz = world_to_grid(pos.x, pos.z)
    local pts = chain.pts
    local n = #pts
    if n == 0 then
        pts[1] = { x = pos.x, y = pos.y, z = pos.z, ix = ix, iz = iz, t = tg, w = base_w, landmark = true }
        return true
    end

    local last_pt = pts[n]
    local dx = pos.x - last_pt.x
    local dz = pos.z - last_pt.z
    local dy = math.abs(pos.y - last_pt.y)
    local d2 = dx * dx + dz * dz

    if d2 > 49.0 or dy > 2.80 then -- > 7m teleport break
        chain.closed = true
        return append_world_trail_point(actor_id, pos, tg, base_w, true)
    end

    local req_d2 = 0.42 -- 0.65m straight step (consolidated into <=28m landmarks behind the actor!)
    if n >= 2 then
        local prev_pt = pts[n - 1]
        local vx1, vz1 = last_pt.x - prev_pt.x, last_pt.z - prev_pt.z
        local l1 = math.sqrt(vx1 * vx1 + vz1 * vz1)
        local l2 = math.sqrt(d2)
        if l1 > 0.05 and l2 > 0.05 then
            local cos_a = (vx1 * dx + vz1 * dz) / (l1 * l2)
            if cos_a < 0.95 then
                req_d2 = 0.30 -- 0.55m crisp curve preservation around sandbags & corners!
            end
        end
    else
        req_d2 = 0.25 -- 0.50m first step
    end

    if d2 < req_d2 then
        return false
    end

    if ix == last_pt.ix and iz == last_pt.iz then
        return false
    end

    -- Gentle boot-tip merge on pure straight steps (<= 9cm deviation, <= 4.5m) right behind feet
    if n >= 2 and not last_pt.landmark then
        local prev_pt = pts[n - 1]
        local acx = pos.x - prev_pt.x
        local acz = pos.z - prev_pt.z
        local ac_len2 = acx * acx + acz * acz
        if ac_len2 > 0.04 and ac_len2 <= 20.25 and (tg - prev_pt.t) <= 8000 then
            local abx = last_pt.x - prev_pt.x
            local abz = last_pt.z - prev_pt.z
            local perp_err = math.abs(abx * acz - abz * acx) / math.sqrt(ac_len2)
            if perp_err <= 0.09 then
                pts[n] = { x = pos.x, y = pos.y, z = pos.z, ix = ix, iz = iz, t = tg, w = base_w, landmark = false }
                return true
            end
        end
    end

    pts[n + 1] = { x = pos.x, y = pos.y, z = pos.z, ix = ix, iz = iz, t = tg, w = base_w, landmark = false }

    -- One-time permanent Landmark Consolidation 3 steps (~2.0m) behind the head:
    -- Checks deviation against both the immediate chord (A->C) and the 2.5m lookahead chord (A->head)
    -- so +-25cm human/AI stride sway consolidates into ~25-30m straight landmarks (~12 floats per 200m!)
    -- while EVERY real turn (>= 30 deg around sandbags/corners) has wide_err >> 0.40m and locks permanently!
    local total = #pts
    if total >= 6 then
        local idx_b = total - 3
        local pt_b = pts[idx_b]
        if not pt_b.landmark then
            local pt_a = pts[idx_b - 1]
            local pt_c = pts[idx_b + 1]
            local pt_h = pts[total]

            local acx, acz = pt_c.x - pt_a.x, pt_c.z - pt_a.z
            local ac_len = math.sqrt(acx * acx + acz * acz)
            local ahx, ahz = pt_h.x - pt_a.x, pt_h.z - pt_a.z
            local ah_len = math.sqrt(ahx * ahx + ahz * ahz)

            local abx, abz = pt_b.x - pt_a.x, pt_b.z - pt_a.z
            local bcx, bcz = pt_c.x - pt_b.x, pt_c.z - pt_b.z
            local l_ab = math.sqrt(abx * abx + abz * abz)
            local l_bc = math.sqrt(bcx * bcx + bcz * bcz)
            local cos_turn = (l_ab > 0.05 and l_bc > 0.05) and ((abx * bcx + abz * bcz) / (l_ab * l_bc)) or 1.0

            local perp_local = (ac_len > 0.05) and (math.abs(abx * acz - abz * acx) / ac_len) or 0.0
            local perp_wide  = (ah_len > 0.10) and (math.abs(abx * ahz - abz * ahx) / ah_len) or 0.0

            if perp_local <= 0.38 and perp_wide <= 0.42 and cos_turn > -0.15 and ac_len <= 32.0 and (pt_c.t - pt_a.t) <= 65000 then
                table.remove(pts, idx_b)
            else
                pt_b.landmark = true
            end
        end
    end

    return true
end

local function close_actor_trail(actor_id)
    local chains = world_trails[actor_id]
    if chains and #chains > 0 then
        chains[#chains].closed = true
    end
end

local function prune_expired_world_trails(tg)
    if tg < last_prune_tg + 2000 then return end
    last_prune_tg = tg

    local ttl_sec = get_trench_ttl_sec()
    for actor_id, chains in pairs(world_trails) do
        local c_idx = 1
        while c_idx <= #chains do
            local ch = chains[c_idx]
            local pts = ch.pts
            while #pts > 0 and eval_node_strength(pts[1], tg, ttl_sec) <= 0.02 do
                table.remove(pts, 1)
            end
            if #pts < 2 and ch.closed then
                table.remove(chains, c_idx)
            elseif #pts == 0 then
                table.remove(chains, c_idx)
            else
                c_idx = c_idx + 1
            end
        end
        if #chains == 0 and actor_id ~= PLAYER_TRAIL_ID then
            world_trails[actor_id] = nil
        end
    end
end

-- 3. Map-Wide Continuous Per-Frame (dt) Campfire Snow Melting & Re-Snowing
local function is_campfire_lit(binder)
    if not binder or not binder.campfire or not binder.object then return false end
    local burning = false
    if binder.campfire.is_on and binder.campfire:is_on() then burning = true end
    if binder.object.is_campfire_burning and not binder.object:is_campfire_burning() then burning = false end
    return burning
end

local function update_campfire_snow_melt(tg)
    local dt = 0.016
    if last_cf_frame_tg > 0 then
        dt = clamp_val((tg - last_cf_frame_tg) * 0.001, 0.001, 0.12)
    end
    last_cf_frame_tg = tg

    active_cf1_pos, active_cf1_r = nil, 0.0
    active_cf2_pos, active_cf2_r = nil, 0.0
    cf_animating_near = false

    if not cfg_campfire_melt or is_underground_level() or not db.actor then return end
    if not bind_campfire or not bind_campfire.campfires_all then return end

    if tg >= last_cf_scan_tg + 300 then
        last_cf_scan_tg = tg
        for id, binder in pairs(bind_campfire.campfires_all) do
            if binder and binder.object then
                local cf_pos = binder.object:position()
                local lit = is_campfire_lit(binder)
                local st = campfire_melt[id]
                if not st then
                    local dist_sqr = cf_pos:distance_to_sqr(device().cam_pos)
                    local saved_r = saved_campfire_radii[id]
                    local init_r = saved_r or ((lit and dist_sqr > 400.0) and cfg_campfire_max_r or 0.0)
                    st = {
                        r = init_r,
                        lit = lit,
                        pos = vector():set(cf_pos),
                        sky = has_open_sky(cf_pos, binder.object),
                    }
                    campfire_melt[id] = st
                else
                    st.lit = lit
                    st.pos:set(cf_pos)
                end
            end
        end
    end

    local dev = device()
    local cam_pos = dev.cam_pos
    local cam_dir = dev.cam_dir
    local w_state = get_snowfall_state()
    local resnow_rate = (w_state >= 4.5) and 0.032 or ((w_state >= 3.5) and 0.025 or 0.020)
    local best_s1 = 99999999.0
    local best_s2 = 99999999.0

    for id, st in pairs(campfire_melt) do
        if st.sky and st.pos then
            local prev_r = st.r
            if st.lit then
                if st.r < cfg_campfire_max_r then
                    local frac_r = clamp_val(st.r / math.max(cfg_campfire_max_r, 0.5), 0.0, 1.0)
                    local melt_speed = 0.082 * (1.15 - 0.65 * frac_r)
                    st.r = math.min(cfg_campfire_max_r, st.r + melt_speed * dt)
                elseif st.r > cfg_campfire_max_r then
                    st.r = math.max(cfg_campfire_max_r, st.r - 0.10 * dt)
                end
            elseif st.r > 0.0 then
                st.r = math.max(0.0, st.r - resnow_rate * dt)
            end

            local d2 = st.pos:distance_to_sqr(cam_pos)
            if math.abs(st.r - prev_r) > 0.00001 and d2 <= 90000.0 then
                cf_animating_near = true
            end

            saved_campfire_radii[id] = (st.r > 0.02) and st.r or nil

            -- Select top 2 campfires across the ENTIRE map (prioritizing nearby + in-view campfires!)
            if st.r > 0.008 then
                local vx, vz = st.pos.x - cam_pos.x, st.pos.z - cam_pos.z
                local dot_fwd = (vx * cam_dir.x + vz * cam_dir.z) / math.max(math.sqrt(d2), 0.1)
                local score = (dot_fwd > 0.25) and (d2 * 0.25) or d2
                if score < best_s1 then
                    best_s2 = best_s1
                    active_cf2_pos, active_cf2_r = active_cf1_pos, active_cf1_r
                    best_s1 = score
                    active_cf1_pos, active_cf1_r = st.pos, st.r
                elseif score < best_s2 then
                    best_s2 = score
                    active_cf2_pos, active_cf2_r = st.pos, st.r
                end
            end
        end
    end
end

-- 4. Dual-Scale Bit-Exact Anchor + Delta Stream Packer (100% Camera-Rotation-Invariant + 3DSS Sniper Priority!)
local function calc_chain_stream_cost(nodes, start_idx)
    local count = #nodes - start_idx + 1
    if count < 2 then return 0 end
    local cost = 2 -- First node is always a 2-float Anchor
    local prev_ix, prev_iz = nodes[start_idx].ix, nodes[start_idx].iz
    for i = start_idx + 1, #nodes do
        local nd = nodes[i]
        local dx = nd.ix - prev_ix
        local dz = nd.iz - prev_iz
        local adx, adz = math.abs(dx), math.abs(dz)
        if adx == 0 and adz == 0 then
            -- duplicate cell skipped
        elseif adx <= 63 and adz <= 63 then
            cost = cost + 1
            prev_ix, prev_iz = nd.ix, nd.iz
        elseif adx <= 378 and adz <= 378 then
            local dx6 = clamp_val(math.floor(dx / 6.0 + 0.5), -63, 63)
            local dz6 = clamp_val(math.floor(dz / 6.0 + 0.5), -63, 63)
            if dx6 ~= 0 or dz6 ~= 0 then
                cost = cost + 1
                prev_ix = clamp_val(prev_ix + dx6 * 6, 0, 16383)
                prev_iz = clamp_val(prev_iz + dz6 * 6, 0, 16383)
            end
        else
            cost = cost + 2
            prev_ix, prev_iz = nd.ix, nd.iz
        end
    end
    return cost
end

local function emit_chain_to_stream(stream, nodes, max_floats)
    local total = #nodes
    if total < 2 or max_floats < 3 then return end

    local start_idx = total - 1
    for candidate = 1, total - 1 do
        if calc_chain_stream_cost(nodes, candidate) <= max_floats then
            start_idx = candidate
            break
        end
    end
    if calc_chain_stream_cost(nodes, start_idx) > max_floats then
        return
    end

    local first = nodes[start_idx]
    local a0, a1 = encode_anchor_floats(first.ix, first.iz, first.s)
    stream[#stream + 1] = a0
    stream[#stream + 1] = a1
    local prev_ix, prev_iz = first.ix, first.iz

    for i = start_idx + 1, total do
        local nd = nodes[i]
        local dx = nd.ix - prev_ix
        local dz = nd.iz - prev_iz
        local adx, adz = math.abs(dx), math.abs(dz)
        if adx ~= 0 or adz ~= 0 then
            if adx <= 63 and adz <= 63 then
                stream[#stream + 1] = encode_delta_float(dx, dz, nd.s, false)
                prev_ix, prev_iz = nd.ix, nd.iz
            elseif adx <= 378 and adz <= 378 then
                local dx6 = clamp_val(math.floor(dx / 6.0 + 0.5), -63, 63)
                local dz6 = clamp_val(math.floor(dz / 6.0 + 0.5), -63, 63)
                if dx6 ~= 0 or dz6 ~= 0 then
                    stream[#stream + 1] = encode_delta_float(dx6, dz6, nd.s, true)
                    prev_ix = clamp_val(prev_ix + dx6 * 6, 0, 16383)
                    prev_iz = clamp_val(prev_iz + dz6 * 6, 0, 16383)
                end
            elseif (#stream + 2) <= MAX_STREAM_FLOATS then
                local b0, b1 = encode_anchor_floats(nd.ix, nd.iz, nd.s)
                stream[#stream + 1] = b0
                stream[#stream + 1] = b1
                prev_ix, prev_iz = nd.ix, nd.iz
            end
        end
    end
end

push_fast_uniforms = function()
    if not get_console then return end
    if is_underground_level() then
        exec_cached("sp2", "shader_param_2 0.000,0.000,0.00000,0.00000")
        exec_cached("cf1_lo", "r4_hdr10_bloom_blur_scale 0.9200000000")
        exec_cached("cf2_lo", "r4_hdr10_bloom_intensity 0.9200000000")
        exec_cached("cf_hi",  "heat_vision_blurring 0.5000,0.5000,0.9200000000,0.0")
        exec_cached("wpn_snow", "r4_hdr10_sun_intensity 1.0000")
        return
    end

    local w_state = get_snowfall_state()
    local snow_accum = (w_state >= 4.5) and 1.00 or ((w_state >= 3.5) and 0.94 or 0.88)
    local freeze_f = 1.0
    if _G.inverno_freezing_mechanic then
        if (_G.inverno_freezing_mechanic.ground_freeze_factor or 1.0) > 0.80 then
            freeze_f = _G.inverno_freezing_mechanic.ground_freeze_factor
        end
        _G.inverno_freezing_mechanic.ground_freeze_factor = freeze_f
        _G.inverno_freezing_mechanic.snow_accumulation_factor = snow_accum
    end

    local cf1_r = (cfg_campfire_melt and active_cf1_pos) and active_cf1_r or 0.0
    local cf2_r = (cfg_campfire_melt and active_cf2_pos) and active_cf2_r or 0.0
    local cf1_lo, cf2_lo, cf_hi = encode_fullmap_campfires(active_cf1_pos, cf1_r, active_cf2_pos, cf2_r)
    local wpn_val = 1.0 + (cfg_weapon_snow and clamp_val(weapon_snow_amount * cfg_weapon_snow_int, 0.0, 2.0) or 0.0)
    local npc_s = 0.50 + clamp_val(cfg_npc_snow_int, 0.0, 2.0)
    local obj_s = 0.50 + clamp_val(cfg_object_snow_int, 0.0, 2.0)

    exec_cached("sp2",    string.format("shader_param_2 %.3f,%.3f,%.5f,%.5f", freeze_f, snow_accum, cf1_r, cf2_r))
    exec_cached("cf1_lo", string.format("r4_hdr10_bloom_blur_scale %.10f", cf1_lo))
    exec_cached("cf2_lo", string.format("r4_hdr10_bloom_intensity %.10f", cf2_lo))
    exec_cached("cf_hi",  string.format("heat_vision_blurring %.4f,%.4f,%.10f,0.0", npc_s, obj_s, cf_hi))
    exec_cached("wpn_snow", string.format("r4_hdr10_sun_intensity %.4f", wpn_val))
end

local function is_actor_aiming(dev)
    if axr_main and axr_main.weapon_is_zoomed then
        return true
    end
    if db.actor then
        local wpn = db.actor:active_item()
        if wpn and wpn.cast_Weapon then
            local ok, c_wpn = pcall(function() return wpn:cast_Weapon() end)
            if ok and c_wpn and c_wpn.IsZoomed and c_wpn:IsZoomed() then
                return true
            end
        end
    end
    local fov = (dev and dev.fov) or 75.0
    return (fov < 56.0)
end

local function push_trail_fullmap_uniforms(tg)
    if not get_console then return end

    local stream = {}
    local new_active_chains = {}

    if cfg_enable_dynsnow and not is_underground_level() and db.actor then
        local dev = device()
        local apos = db.actor:position()
        local ax, az = apos.x, apos.z
        local cam_pos = dev.cam_pos
        local cam_dir = dev.cam_dir
        local cx, cz = cam_pos.x, cam_pos.z
        local dir_xz_len = math.sqrt(cam_dir.x * cam_dir.x + cam_dir.z * cam_dir.z)
        local dir_x = (dir_xz_len > 0.001) and (cam_dir.x / dir_xz_len) or 0.0
        local dir_z = (dir_xz_len > 0.001) and (cam_dir.z / dir_xz_len) or 1.0
        local is_ads = is_actor_aiming(dev)
        local ttl_sec = get_trench_ttl_sec()

        local player_subs = {}
        local npc_subs = {}
        local best_sniper_uid = nil
        local best_sniper_perp2 = 324.0 -- <= 18m perpendicular to scope sightline across the whole map!

        for actor_id, chains in pairs(world_trails) do
            if actor_id == PLAYER_TRAIL_ID or cfg_enable_npc_tracks then
                for c_i = 1, #chains do
                    local ch = chains[c_i]
                    local pts = ch.pts
                    local total_pts = #pts

                    -- Live boot tip for BOTH Player AND walking NPCs/Mutants so trenches connect right under their boots!
                    local live_pt = nil
                    if c_i == #chains and not ch.closed and total_pts >= 1 then
                        local cand = (actor_id == PLAYER_TRAIL_ID) and player_live_head or entity_live_pos[actor_id]
                        if cand and (tg - cand.t) <= 3500 then
                            local lp = pts[total_pts]
                            local ldx = cand.x - lp.x
                            local ldz = cand.z - lp.z
                            if (ldx * ldx + ldz * ldz) >= 0.0324 and (cand.ix ~= lp.ix or cand.iz ~= lp.iz) then
                                live_pt = cand
                            end
                        end
                    end

                    local count_with_live = total_pts + (live_pt and 1 or 0)
                    local cur_nodes = {}
                    local min_d2_actor = 999999999.0
                    local newest_t = 0

                    for p_i = 1, count_with_live do
                        local pt = (p_i <= total_pts) and pts[p_i] or live_pt
                        if math.abs(pt.x) <= 1595.0 and math.abs(pt.z) <= 1595.0 then
                            local str = eval_node_strength(pt, tg, ttl_sec)
                            if str > 0.02 then
                                cur_nodes[#cur_nodes + 1] = { x = pt.x, z = pt.z, ix = pt.ix, iz = pt.iz, s = str }
                                if pt.t > newest_t then newest_t = pt.t end

                                -- 100% Camera-Rotation-Invariant world distance to player!
                                -- Looking around NEVER changes min_d2_actor, so trails NEVER pop, shift, or vanish when turning your head!
                                local adx = pt.x - ax
                                local adz = pt.z - az
                                local d2_actor = adx * adx + adz * adz
                                if d2_actor < min_d2_actor then min_d2_actor = d2_actor end

                                -- Dedicated 3DSS / Sniper Scope Aimed-Target detector (active ONLY while aiming down sights!)
                                if is_ads and not ch.is_player and ch.uid then
                                    local rdx = pt.x - cx
                                    local rdz = pt.z - cz
                                    local proj = rdx * dir_x + rdz * dir_z
                                    if proj > 15.0 then
                                        local px = rdx - dir_x * proj
                                        local pz = rdz - dir_z * proj
                                        local perp2 = px * px + pz * pz
                                        if perp2 < best_sniper_perp2 then
                                            best_sniper_perp2 = perp2
                                            best_sniper_uid = ch.uid
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if #cur_nodes >= 2 then
                        local best_score = min_d2_actor
                        -- Strong sticky hysteresis (0.42x) guarantees zero swapping between similarly-distanced NPCs!
                        if ch.uid and active_gpu_chains[ch.uid] then
                            best_score = best_score * 0.42
                        end
                        local entry = { uid = ch.uid, nodes = cur_nodes, score = best_score, newest_t = newest_t }
                        if ch.is_player then
                            player_subs[#player_subs + 1] = entry
                        else
                            npc_subs[#npc_subs + 1] = entry
                        end
                    end
                end
            end
        end

        -- Guarantee any distant Stalker/Mutant under your 3DSS/optic crosshair gets top NPC priority!
        if is_ads and best_sniper_uid then
            for i = 1, #npc_subs do
                if npc_subs[i].uid == best_sniper_uid then
                    npc_subs[i].score = -1.0
                    break
                end
            end
        end

        table.sort(player_subs, function(a, b) return a.newest_t > b.newest_t end)
        table.sort(npc_subs, function(a, b) return a.score < b.score end)

        -- Guaranteed minimum 14 floats (~160-250m consolidated trail!) for the Player; camera-invariant NPC reserve!
        local npc_floats_wanted = 0
        for i = 1, math.min(#npc_subs, 5) do
            local cost = calc_chain_stream_cost(npc_subs[i].nodes, 1)
            npc_floats_wanted = npc_floats_wanted + math.min(cost, 7)
        end
        local npc_reserve = math.min(npc_floats_wanted, MAX_STREAM_FLOATS - 14)
        local player_cap = MAX_STREAM_FLOATS - npc_reserve

        -- 1. Emit Player trail(s)
        for i = 1, #player_subs do
            local rem = player_cap - #stream
            if rem < 3 then break end
            local before = #stream
            emit_chain_to_stream(stream, player_subs[i].nodes, rem)
            if #stream > before and player_subs[i].uid then
                new_active_chains[player_subs[i].uid] = true
            end
        end

        -- 2. Emit up to 6 simultaneous NPC & Mutant trails across the map (50-150m+ each via consolidated landmarks!)
        for i = 1, #npc_subs do
            local rem = MAX_STREAM_FLOATS - #stream
            if rem < 3 then break end
            local remaining_npcs = #npc_subs - i
            local per_npc_cap = rem
            if remaining_npcs >= 1 and rem >= 7 then
                per_npc_cap = math.min(rem - 3, 8)
            end
            local before = #stream
            emit_chain_to_stream(stream, npc_subs[i].nodes, per_npc_cap)
            if #stream > before and npc_subs[i].uid then
                new_active_chains[npc_subs[i].uid] = true
            end
        end
    end

    active_gpu_chains = new_active_chains

    local raw = {}
    for i = 1, MAX_STREAM_FLOATS do
        raw[i] = stream[i] or 0.92
    end

    for i = 1, 22 do
        local spec = SCALAR_RAW_SLOTS[i]
        local val = raw[i]
        local send_val = spec.sub1 and (val - 1.0) or val
        exec_cached("raw_" .. i, string.format("%s %.10f", spec.cmd, send_val))
    end
    exec_cached("raw_23_25", string.format("r4_hdr10_flare_lens_color %.10f,%.10f,%.10f", raw[23], raw[24], raw[25]))
    exec_cached("raw_26_29", string.format("heat_vision_steps %.10f,%.10f,%.10f,%.10f", raw[26], raw[27], raw[28], raw[29]))
    exec_cached("raw_30_33", string.format("heat_vision_args_1 %.10f,%.10f,%.10f,%.10f", raw[30], raw[31], raw[32], raw[33]))
    exec_cached("raw_34_37", string.format("heat_vision_args_2 %.10f,%.10f,%.10f,%.10f", raw[34], raw[35], raw[36], raw[37]))
end

-- Particle helpers (safe across level transitions and on both Project INVERNO and standalone setups!)
local function play_snow_puff(pos)
    if level_is_changing or not cfg_enable_env_fx or not _G.inverno_snowfall_system then return end
    local slot = puff_idx
    local p = puff_pool[slot]
    if not p then
        local ok, obj = pcall(function() return particles_object("inverno\\snow_dust") end)
        if ok and obj then p = obj puff_pool[slot] = p end
    end
    puff_idx = (puff_idx % MAX_PUFF_POOL) + 1
    if p then
        if p:playing() then p:stop() end
        p:play_at_pos(pos)
        local stop_id = "dynsnow_puff_" .. tostring(slot)
        CreateTimeEvent("dynsnow_fx", stop_id, 0.55, function()
            local cur_p = puff_pool[slot]
            if cur_p and cur_p:playing() then cur_p:stop() end
            return true
        end)
    end
end

local function play_tree_snow_cascade(pos)
    if level_is_changing or not cfg_enable_env_fx or not _G.inverno_snowfall_system then return end
    local slot = tree_cascade_idx
    local p = tree_cascade_pool[slot]
    if not p then
        local ok, obj = pcall(function() return particles_object("inverno\\snow_heavy") end)
        if ok and obj then p = obj tree_cascade_pool[slot] = p end
    end
    tree_cascade_idx = (tree_cascade_idx % MAX_TREE_POOL) + 1
    if p then
        if p:playing() then p:stop() end
        p:play_at_pos(vector():set(pos.x, pos.y - 0.35, pos.z))
        local stop_id = "dynsnow_tree_" .. tostring(slot)
        CreateTimeEvent("dynsnow_fx", stop_id, 1.75, function()
            local cur_p = tree_cascade_pool[slot]
            if cur_p and cur_p:playing() then cur_p:stop() end
            return true
        end)
    end
    play_snow_puff(pos)
end

-- 5. Player 3D Snow Trench Tracking
local function update_player_trail(tg)
    if not cfg_enable_dynsnow or not db.actor or not db.actor:alive() or is_underground_level() then
        player_live_head = nil
        if player_was_valid then
            close_actor_trail(PLAYER_TRAIL_ID)
            player_was_valid = false
        end
        return
    end

    local apos = db.actor:position()
    local valid_snow = (not is_actor_indoors()) and (not is_inside_melted_campfire_zone(apos))

    if not valid_snow then
        player_live_head = nil
        if player_was_valid then
            close_actor_trail(PLAYER_TRAIL_ID)
            player_was_valid = false
        end
        return
    end

    local force_new = not player_was_valid
    player_was_valid = true
    local pix, piz = world_to_grid(apos.x, apos.z)
    player_live_head = { x = apos.x, y = apos.y, z = apos.z, ix = pix, iz = piz, t = tg, w = 1.0 }

    if tg >= last_player_track_tg + 80 then
        last_player_track_tg = tg
        append_world_trail_point(PLAYER_TRAIL_ID, apos, tg, 1.0, force_new)
    end
end

function actor_on_footstep(mat, power, hud_view, flags)
    local tg = time_global()
    sync_mcm(tg)
    if not cfg_enable_dynsnow or not db.actor or is_underground_level() then return end
    if is_actor_indoors() then return end

    local apos = db.actor:position()
    if is_inside_melted_campfire_zone(apos) then return end

    local move_state = level.actor_moving_state and level.actor_moving_state() or 0
    local is_sprint = (bit_and and bit_and(move_state, 4096) ~= 0) or false
    if is_sprint then
        play_snow_puff(apos)
    end
end

function actor_on_land(landing_speed)
    local tg = time_global()
    sync_mcm(tg)
    if not cfg_enable_dynsnow or not db.actor or is_underground_level() then return end
    if is_actor_indoors() then return end

    local pos = db.actor:position()
    if is_inside_melted_campfire_zone(pos) then return end

    append_world_trail_point(PLAYER_TRAIL_ID, pos, tg, 1.0, false)
    play_snow_puff(pos)
end

-- 6. Map-Wide Stalker & Mutant 3D Snow Trenches (No 45m limit — tracks ALL online entities across the map!)
local function get_mutant_trench_strength(obj)
    local id = obj:id()
    if entity_strength_cache[id] ~= nil then return entity_strength_cache[id] end
    local sec = string.lower(obj:section() or "")
    if string.find(sec, "poltergeist") or string.find(sec, "crow") then
        entity_strength_cache[id] = 0.0
        return 0.0
    end
    local w = 0.85
    for pat, val in pairs(MUTANT_TRENCH_STRENGTH) do
        if string.find(sec, pat) then w = val break end
    end
    entity_strength_cache[id] = w
    return w
end

local function process_entity_step(obj, is_monster)
    if level_is_changing or not cfg_enable_dynsnow or not cfg_enable_npc_tracks or is_underground_level() then return end
    if not obj or not obj:alive() then return end

    local id = obj:id()
    local tg = time_global()
    if tg < (entity_next_check_tg[id] or 0) then return end

    local pos = obj:position()
    local d2_cam = pos:distance_to_sqr(device().cam_pos)
    -- Responsive check interval across both near range (<85m: 110ms) and sniper range (260ms)
    entity_next_check_tg[id] = tg + ((d2_cam <= 7225.0) and 110 or 260)

    local base_w = is_monster and get_mutant_trench_strength(obj) or 0.96
    if base_w <= 0.05 then return end

    local prev = entity_last_pos[id]
    if not prev then
        entity_last_pos[id] = vector():set(pos)
        return
    end

    local dx = pos.x - prev.x
    local dz = pos.z - prev.z
    local dy = math.abs(pos.y - prev.y)
    local horiz_sqr = dx * dx + dz * dz
    if horiz_sqr < 0.0324 then return end -- < 18cm idle micro-jitter ignored

    if dy > 2.8 or is_inside_melted_campfire_zone(pos) then
        entity_last_pos[id] = vector():set(pos)
        entity_live_pos[id] = nil
        if entity_chain_active[id] then
            close_actor_trail(id)
            entity_chain_active[id] = false
        end
        return
    end

    local outdoor_entry = entity_outdoor_cache[id]
    if not outdoor_entry or tg > outdoor_entry.exp then
        entity_outdoor_cache[id] = { ok = has_open_sky(pos, obj), exp = tg + 1800 }
        outdoor_entry = entity_outdoor_cache[id]
    end
    if not outdoor_entry.ok then
        entity_last_pos[id] = vector():set(pos)
        entity_live_pos[id] = nil
        if entity_chain_active[id] then
            close_actor_trail(id)
            entity_chain_active[id] = false
        end
        return
    end

    -- Keep live boot tip updated right under walking NPC/Mutant feet!
    local nix, niz = world_to_grid(pos.x, pos.z)
    entity_live_pos[id] = { x = pos.x, y = pos.y, z = pos.z, ix = nix, iz = niz, t = tg, w = base_w }

    local force_new = not entity_chain_active[id]
    entity_chain_active[id] = true
    if append_world_trail_point(id, pos, tg, base_w, force_new) then
        entity_last_pos[id] = vector():set(pos)
    end
end

function npc_on_update(npc) process_entity_step(npc, false) end
function monster_on_update(mob) process_entity_step(mob, true) end

local function cleanup_entity(obj)
    if not obj then return end
    local id = obj:id()
    close_actor_trail(id)
    entity_last_pos[id] = nil
    entity_live_pos[id] = nil
    entity_next_check_tg[id] = nil
    entity_outdoor_cache[id] = nil
    entity_strength_cache[id] = nil
    entity_chain_active[id] = nil
end

-- 7. Gunshots & Explosion Snow FX
function actor_on_weapon_fired(obj, wpn, ammo_elapsed, grenade_elapsed, ammo_type, gl_type)
    local tg = time_global()
    sync_mcm(tg)

    if cfg_weapon_snow and weapon_snow_amount > 0.10 then
        weapon_snow_amount = math.max(0.10, weapon_snow_amount - 0.055)
        push_fast_uniforms()
    end

    if not cfg_enable_dynsnow or not cfg_enable_env_fx or is_underground_level() then return end
    if tg < last_shot_fx_tg + 95 then return end
    last_shot_fx_tg = tg

    local dev = device()
    local cam_pos = dev.cam_pos
    local cam_dir = dev.cam_dir

    local pick = ray_pick()
    pick:set_position(cam_pos)
    pick:set_direction(cam_dir)
    pick:set_flags(2)
    pick:set_range(55.0)
    if db.actor then pick:set_ignore_object(db.actor) end
    pick:query()

    local dist = pick:get_distance()
    if dist <= 0.8 or dist >= 54.5 then return end

    local hit_pos = vector():set(cam_pos):mad(cam_dir, dist)

    if cam_dir.y < -0.10 and hit_pos.y <= cam_pos.y + 0.5 then
        if not is_inside_melted_campfire_zone(hit_pos) and has_open_sky(hit_pos, db.actor) then
            play_snow_puff(hit_pos)
        end
    elseif db.actor and hit_pos.y > (db.actor:position().y + 2.1) and cam_dir.y > 0.04 then
        local side_probe = vector():set(hit_pos.x + 1.8, hit_pos.y, hit_pos.z)
        if has_open_sky(side_probe, db.actor) then
            play_tree_snow_cascade(hit_pos)
        end
    end
end

local function spawn_explosion_snow_fx(pos)
    if not pos then return end
    local tg = time_global()
    if tg < last_explosion_tg + 250 then return end
    last_explosion_tg = tg
    if not cfg_enable_dynsnow or not cfg_enable_env_fx or is_underground_level() then return end
    if not has_open_sky(pos, db.actor) then return end

    append_world_trail_point(90000 + math.random(1, 999), pos, tg, 1.0, true)
    play_snow_puff(vector():set(pos.x, pos.y + 0.3, pos.z))
    play_tree_snow_cascade(vector():set(pos.x, pos.y + 3.2, pos.z))
end

local function entity_on_before_hit(victim, s_hit, bone_id, flags)
    if not victim or type(s_hit) ~= "userdata" then return end
    local ok, is_expl = pcall(function() return s_hit.type == hit.explosion end)
    if ok and is_expl then
        spawn_explosion_snow_fx(victim:position())
    end
end

local function actor_on_before_hit_safe(s_hit, bone_id, flags)
    if not db.actor or type(s_hit) ~= "userdata" then return end
    local ok, is_expl = pcall(function() return s_hit.type == hit.explosion end)
    if ok and is_expl then
        spawn_explosion_snow_fx(db.actor:position())
    end
end

-- 8. Main Update Loop
function actor_on_update()
    if level_is_changing then return end
    local tg = time_global()
    sync_mcm(tg)
    ensure_inverno_always_snow_hook()
    update_campfire_snow_melt(tg)
    update_player_trail(tg)
    prune_expired_world_trails(tg)

    if db.actor and db.actor:alive() and not is_underground_level() then
        if tg > last_wpn_snow_tg + 400 then
            last_wpn_snow_tg = tg
            local apos = db.actor:position()
            local inside = is_actor_indoors()
            local near_warm_fire = (active_cf1_pos and active_cf1_r > 0.65 and apos:distance_to_sqr(active_cf1_pos) <= 10.0)
                or (active_cf2_pos and active_cf2_r > 0.65 and apos:distance_to_sqr(active_cf2_pos) <= 10.0)

            if not cfg_weapon_snow then
                weapon_snow_amount = 0.0
            elseif inside or near_warm_fire then
                local melt_rate = near_warm_fire and 0.036 or 0.018
                weapon_snow_amount = math.max(0.0, weapon_snow_amount - melt_rate)
            else
                local w_state = get_snowfall_state()
                local target_wpn = (w_state >= 4.5) and 0.88 or ((w_state >= 3.5) and 0.76 or 0.66)
                local build_rate = (w_state >= 4.0) and 0.020 or 0.012
                if weapon_snow_amount < target_wpn then
                    weapon_snow_amount = math.min(target_wpn, weapon_snow_amount + build_rate)
                else
                    weapon_snow_amount = math.max(target_wpn, weapon_snow_amount - 0.008)
                end
            end
        end
    end

    local fast_interval = cf_animating_near and 33 or 120
    if tg >= last_fast_uniform_tg + fast_interval then
        last_fast_uniform_tg = tg
        push_fast_uniforms()
    end

    if tg >= last_trail_push_tg + 75 then
        last_trail_push_tg = tg
        push_trail_fullmap_uniforms(tg)
    end
end

local function release_level_pools()
    for i = 1, MAX_PUFF_POOL do
        if RemoveTimeEvent then
            pcall(RemoveTimeEvent, "dynsnow_fx", "dynsnow_puff_" .. tostring(i))
        end
        local p = puff_pool[i]
        if p then
            pcall(function()
                if p:playing() then
                    if p.stop_deffered then p:stop_deffered() else p:stop() end
                end
            end)
            puff_pool[i] = nil
        end
    end
    for i = 1, MAX_TREE_POOL do
        if RemoveTimeEvent then
            pcall(RemoveTimeEvent, "dynsnow_fx", "dynsnow_tree_" .. tostring(i))
        end
        local p = tree_cascade_pool[i]
        if p then
            pcall(function()
                if p:playing() then
                    if p.stop_deffered then p:stop_deffered() else p:stop() end
                end
            end)
            tree_cascade_pool[i] = nil
        end
    end
    puff_pool             = {}
    tree_cascade_pool     = {}
    campfire_melt         = {}
    active_cf1_pos        = nil
    active_cf1_r          = 0.0
    active_cf2_pos        = nil
    active_cf2_r          = 0.0
    cf_animating_near     = false
    world_trails          = {}
    player_live_head      = nil
    player_was_valid      = false
    entity_last_pos       = {}
    entity_live_pos       = {}
    entity_next_check_tg  = {}
    entity_outdoor_cache  = {}
    entity_strength_cache = {}
    entity_chain_active   = {}
    active_gpu_chains     = {}
    cmd_cache             = {}
end

function save_state(m_data)
    m_data.dynsnow_campfire_radii = saved_campfire_radii
    m_data.dynsnow_weapon_snow    = weapon_snow_amount
end

function load_state(m_data)
    saved_campfire_radii = m_data.dynsnow_campfire_radii or {}
    weapon_snow_amount   = m_data.dynsnow_weapon_snow or 0.65
    release_level_pools()
end

local function actor_on_first_update()
    level_is_changing = false
    local tg = time_global()
    sync_mcm(tg)
    ensure_inverno_always_snow_hook()
    push_fast_uniforms()
    push_trail_fullmap_uniforms(tg)
end

local function actor_on_net_destroy()
    level_is_changing = true
    release_level_pools()
end

local function on_before_level_changing()
    level_is_changing = true
    release_level_pools()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_footstep", actor_on_footstep)
    RegisterScriptCallback("actor_on_land", actor_on_land)
    RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
    RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
    RegisterScriptCallback("npc_on_update", npc_on_update)
    RegisterScriptCallback("monster_on_update", monster_on_update)
    RegisterScriptCallback("npc_on_net_destroy", cleanup_entity)
    RegisterScriptCallback("monster_on_net_destroy", cleanup_entity)
    RegisterScriptCallback("npc_on_before_hit", entity_on_before_hit)
    RegisterScriptCallback("monster_on_before_hit", entity_on_before_hit)
    RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit_safe)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end
