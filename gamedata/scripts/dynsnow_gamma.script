-- Exact C++ verified HDR10 uniform table (sub1 = true where C++ setup() executes vaddss +1.0f!)
local TRAIL_SLOTS = {
    { cmd = "r4_hdr10_exposure",               sub1 = false }, -- slot 1  (hdr10_parameters3.x)
    { cmd = "r4_hdr10_contrast",               sub1 = true  }, -- slot 2  (hdr10_parameters3.y = 1.0 + contrast)
    { cmd = "r4_hdr10_saturation",             sub1 = true  }, -- slot 3  (hdr10_parameters3.z = 1.0 + saturation)
    { cmd = "r4_hdr10_contrast_middle_gray",   sub1 = false }, -- slot 4  (hdr10_parameters3.w)
    { cmd = "r4_hdr10_sun_dawn_begin",         sub1 = false }, -- slot 5  (hdr10_parameters5.x)
    { cmd = "r4_hdr10_sun_dawn_end",           sub1 = false }, -- slot 6  (hdr10_parameters5.y)
    { cmd = "r4_hdr10_sun_dusk_begin",         sub1 = false }, -- slot 7  (hdr10_parameters5.z)
    { cmd = "r4_hdr10_sun_dusk_end",           sub1 = false }, -- slot 8  (hdr10_parameters5.w)
    { cmd = "r4_hdr10_brightness",             sub1 = false }, -- slot 9  (hdr10_parameters6.x)
    { cmd = "r4_hdr10_flare_threshold",        sub1 = false }, -- slot 10 (hdr10_parameters6.z)
    { cmd = "r4_hdr10_flare_power",            sub1 = false }, -- slot 11 (hdr10_parameters6.w)
    { cmd = "r4_hdr10_flare_ghost_dispersal",  sub1 = false }, -- slot 12 (hdr10_parameters7.y)
    { cmd = "r4_hdr10_flare_center_falloff",   sub1 = false }, -- slot 13 (hdr10_parameters7.z)
    { cmd = "r4_hdr10_flare_halo_scale",       sub1 = false }, -- slot 14 (hdr10_parameters7.w)
    { cmd = "r4_hdr10_flare_halo_ca",          sub1 = false }, -- slot 15 (hdr10_parameters8.x)
    { cmd = "r4_hdr10_flare_ghost_ca",         sub1 = false }, -- slot 16 (hdr10_parameters8.y)
    { cmd = "r4_hdr10_flare_blur_scale",       sub1 = false }, -- slot 17 (hdr10_parameters8.z)
    { cmd = "r4_hdr10_ui_saturation",          sub1 = true  }, -- slot 18 (hdr10_parameters8.w = 1.0 + ui_saturation)
    { cmd = "r4_hdr10_flare_ghost_intensity",  sub1 = false }, -- slot 19 (hdr10_parameters9.x)
    { cmd = "r4_hdr10_flare_halo_intensity",   sub1 = false }, -- slot 20 (hdr10_parameters9.y)
    { cmd = "r4_hdr10_sun_inner_radius",       sub1 = false }, -- slot 21 (hdr10_parameters9.z)
    { cmd = "r4_hdr10_sun_outer_radius",       sub1 = false }, -- slot 22 (hdr10_parameters9.w)
}
-- Slots 23..25 are packed into Vector3 "r4_hdr10_flare_lens_color" (hdr10_parameters10.xyz, raw)
local MAX_GPU_SLOTS = 25
local TORUS_SIZE    = 80.0
local WINDOW_HALF   = 38.5 -- Strictly within [-38.5m, +38.5m] around camera (zero 80m-torus wrap!)

local SKY_RAYS = {
    vector():set(0.0,  1.0,    0.0),
    vector():set(0.28, 0.959,  0.05),
    vector():set(-0.26, 0.959, -0.10),
}

