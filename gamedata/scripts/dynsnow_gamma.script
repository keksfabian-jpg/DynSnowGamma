-- Total = 37 floats (Bit-Exact Hybrid Anchor + 1-Float Delta Stream = up to 35 connected segments!)
local MAX_STREAM_FLOATS = 37

local SKY_RAYS = {
    vector():set(0.0,   1.0,   0.0),
    vector():set(0.18,  0.983, 0.04),
    vector():set(-0.18, 0.983, -0.04),
}

