/**
 * DynSnow for S.T.A.L.K.E.R. G.A.M.M.A.
 * Clean-room Hybrid Wallmark Pixel Shader (Snow Footprints, Campfire Thaw Earth & Blood Decals)
 * License: MIT
 */

#include "common.h"

uniform float4 ssfx_blood_decals;

float4 main(p_TL I) : SV_Target
{
	float4 res = s_base.Sample(smp_base, I.Tex0);
	float life = saturate(1.0f - I.Color.a);

	// DynSnow decals encode cool-tagged channels (B > R * 1.04); blood decals have R >> B
	[branch] if (res.b > res.r * 1.04f)
	{
		float3 env_light = L_hemi_color.rgb * 1.20f + L_ambient.rgb * 0.90f + L_sun_color.rgb * 0.30f;
		float env_lum = clamp(dot(env_light, float3(0.299f, 0.587f, 0.114f)), 0.06f, 1.15f);

		// Dark thawed campfire soil (res.b < 0.53) vs bright pressed snow tracks (res.b >= 0.53)
		[branch] if (res.b < 0.53f)
		{
			float dist_center = length(I.Tex0 - float2(0.5f, 0.5f));
			float hearth_warmth = (1.0f - smoothstep(0.05f, 0.38f, dist_center));
			float3 soil_rgb = float3(res.r * 1.18f, res.g * 1.02f, res.b * 0.72f);
			float3 fire_bounce = float3(0.26f, 0.17f, 0.10f) * hearth_warmth;
			float3 lit_soil = soil_rgb * max(env_light, float3(0.14f, 0.14f, 0.15f)) + fire_bounce * soil_rgb;
			float thaw_fade = smoothstep(0.0f, 0.55f, life);
			return float4(saturate(lit_soil), saturate(res.a * thaw_fade * 0.78f));
		}

		float3 lit_snow = res.rgb * lerp(float3(env_lum * 0.96f, env_lum, env_lum * 1.06f), env_light, 0.42f);
		float fill_fade = smoothstep(0.0f, 0.82f, life);
		return float4(saturate(lit_snow), saturate(res.a * fill_fade));
	}

	// Preserve standard Screen Space Shaders blood wallmark behavior
	res.rgb *= ssfx_blood_decals.x;
	res.a = saturate(res.a * 1.7f - 0.7f) * ssfx_blood_decals.y;
	res.a *= life;
	return float4(res.rgb, res.a);
}
